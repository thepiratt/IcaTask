@model PaymentApprovalPortal.Models.CreatePaymentViewModel
@{
    ViewData["Title"] = "New payment";
}

<h1 class="h3 mb-3">New payment</h1>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="ReceiverName" class="form-label"></label>
                <input asp-for="ReceiverName" class="form-control" maxlength="50" autocomplete="off" />
                <span asp-validation-for="ReceiverName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AccountNumber" class="form-label"></label>
                <input asp-for="AccountNumber" class="form-control" inputmode="numeric"
                       pattern="\d{6,}" autocomplete="off" />
                <div class="form-text">Digits only, at least 6 digits.</div>
                <span asp-validation-for="AccountNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                <div class="form-text">
                    Payments above 10 000 SEK require approval before execution.
                </div>
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaymentMessage" class="form-label"></label>
                <textarea asp-for="PaymentMessage" class="form-control" rows="3" maxlength="140"></textarea>
                <span asp-validation-for="PaymentMessage" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create payment</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

