@model PaymentApprovalPortal.Models.CreatePaymentViewModel
@{
    ViewData["Title"] = "New payment";
}

<h1>New payment</h1>

<form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="ReceiverName"></label>
        <input asp-for="ReceiverName" maxlength="50" autocomplete="off" />
        <span asp-validation-for="ReceiverName"></span>
    </div>

    <div>
        <label asp-for="AccountNumber"></label>
        <input asp-for="AccountNumber" inputmode="numeric" pattern="\d{6,}" autocomplete="off" />
        <small>Digits only, at least 6 digits.</small>
        <span asp-validation-for="AccountNumber"></span>
    </div>

    <div>
        <label asp-for="Amount"></label>
        <input asp-for="Amount" type="number" step="0.01" min="0.01" />
        <small>Payments above 10 000 SEK require approval before execution.</small>
        <span asp-validation-for="Amount"></span>
    </div>

    <div>
        <label asp-for="PaymentMessage"></label>
        <textarea asp-for="PaymentMessage" rows="3" maxlength="140"></textarea>
        <span asp-validation-for="PaymentMessage"></span>
    </div>

    <button type="submit">Create payment</button>
    <a asp-action="Index">Cancel</a>
</form>

