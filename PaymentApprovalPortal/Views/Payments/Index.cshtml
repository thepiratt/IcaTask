@using System.Globalization
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    ViewData["Title"] = "Payments";
}

<h1>Payments</h1>

<p>
    <a asp-action="Create">New payment</a>
</p>

@if (TempData["Success"] is string success)
{
    <p>@success</p>
}
@if (TempData["Error"] is string error)
{
    <p>@error</p>
}

@if (Model.Count == 0)
{
    <p>No payments yet. Create one to get started.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Created</th>
                <th>Receiver</th>
                <th>Account</th>
                <th>Amount (SEK)</th>
                <th>Message</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in Model)
            {
                <tr>
                    <td>
                        @payment.CreatedDate.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
                    </td>
                    <td>@payment.ReceiverName</td>
                    <td>@payment.AccountNumber</td>
                    <td>
                        @payment.Amount.ToString("N2", CultureInfo.InvariantCulture)
                    </td>
                    <td>@payment.PaymentMessage</td>
                    <td>@payment.Status</td>
                    <td>
                        @if (payment.Status == PaymentApprovalPortal.Models.PaymentStatus.PendingApproval)
                        {
                            <form asp-action="Approve" asp-route-id="@payment.Id" method="post">
                                <button type="submit">Approve</button>
                            </form>
                            <form asp-action="Reject" asp-route-id="@payment.Id" method="post">
                                <button type="submit">Reject</button>
                            </form>
                        }

                        <form asp-action="Delete" asp-route-id="@payment.Id" method="post"
                              onsubmit="return confirm('Delete this payment?');">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
