@using System.Globalization
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    ViewData["Title"] = "Payments";

    string BadgeClass(PaymentApprovalPortal.Models.PaymentStatus status) => status switch
    {
        PaymentApprovalPortal.Models.PaymentStatus.Draft => "bg-secondary",
        PaymentApprovalPortal.Models.PaymentStatus.PendingApproval => "bg-warning text-dark",
        PaymentApprovalPortal.Models.PaymentStatus.Approved => "bg-info text-dark",
        PaymentApprovalPortal.Models.PaymentStatus.Rejected => "bg-danger",
        PaymentApprovalPortal.Models.PaymentStatus.Executed => "bg-success",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Payments</h1>
    <a asp-action="Create" class="btn btn-primary">New payment</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">No payments yet. Create one to get started.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th scope="col">Created</th>
                    <th scope="col">Receiver</th>
                    <th scope="col">Account</th>
                    <th scope="col" class="text-end">Amount (SEK)</th>
                    <th scope="col">Message</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    var collapseId = $"audit-{payment.Id}";
                    <tr>
                        <td class="text-nowrap">
                            @payment.CreatedDate.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
                        </td>
                        <td>@payment.ReceiverName</td>
                        <td><code>@payment.AccountNumber</code></td>
                        <td class="text-end">
                            @payment.Amount.ToString("C", new CultureInfo("sv-SE"))
                        </td>
                        <td class="text-muted">@(payment.PaymentMessage ?? "—")</td>
                        <td>
                            <span class="badge @BadgeClass(payment.Status)">@payment.Status</span>
                        </td>
                        <td class="text-end text-nowrap">
                            @if (payment.Status == PaymentApprovalPortal.Models.PaymentStatus.PendingApproval)
                            {
                                <form asp-action="Approve" asp-route-id="@payment.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@payment.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                </form>
                            }

                            <button class="btn btn-sm btn-outline-secondary"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="false"
                                    aria-controls="@collapseId">
                                Audit
                            </button>

                            <form asp-action="Delete" asp-route-id="@payment.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this payment?');">
                                <button type="submit" class="btn btn-sm btn-outline-dark">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <tr class="collapse" id="@collapseId">
                        <td colspan="7" class="bg-light">
                            <strong class="d-block mb-1">Audit trail</strong>
                            <ul class="mb-0 small">
                                @foreach (var entry in payment.AuditTrail)
                                {
                                    <li>
                                        <span class="text-muted">
                                            @entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
                                        </span>
                                        &mdash; @entry.Description
                                    </li>
                                }
                            </ul>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
